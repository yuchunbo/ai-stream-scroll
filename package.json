{
  "name": "ai-stream-scroll",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/ai-stream-scroll.cjs.js",
  "module": "./dist/ai-stream-scroll.es.js",
  "exports": {
    ".": {
      "import": "./dist/ai-stream-scroll.es.js",
      "require": "./dist/ai-stream-scroll.cjs.js"
    },
    "./dist/style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "dev:example": "vite serve examples --config vite.config.ts --mode example",
    "build:example": "vue-tsc && vite build --config vite.config.ts --mode example",
    "build:gh-pages": "vue-tsc && vite build --config vite.config.ts --mode gh-pages",
    "deploy:gh-pages": "npm run build:gh-pages && gh-pages -d dist-gh-pages"
  },
  "dependencies": {
    "vue": "^3.3.0"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.5.0",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vue-tsc": "^2.0.0"
  }
}
